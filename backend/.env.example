OPENAI_API_KEY=your-openai-api-key-here

# Qdrant Cloud (recommended) — set both URL and API key
QDRANT_URL=https://xxxx-xxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key-here

# Qdrant local (fallback if cloud URL/API key are empty)
QDRANT_HOST=localhost
QDRANT_PORT=6333

QDRANT_COLLECTION=davinci_resolve_guide
